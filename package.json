{
  "name": "easylib.ts",
  "version": "0.2.0",
  "description": "The foundational library for bulletproof TypeScript: Java-style Collections, Maps, Streams, Functionals, Optional, and Result types for safer type-driven development.",
  "keywords": [
    "typescript",
    "java",
    "stream",
    "optional",
    "result",
    "data-structures",
    "collections",
    "functional-programming",
    "fluent-api",
    "monad"
  ],
  "homepage": "https://github.com/christianbraghette/lib.ts#readme",
  "bugs": {
    "url": "https://github.com/christianbraghette/lib.ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christianbraghette/lib.ts.git"
  },
  "license": "MPL-2.0",
  "author": "Christian Braghette",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./collections": {
      "types": "./dist/collections.d.ts",
      "default": "./dist/collections.js"
    },
    "./maps": {
      "types": "./dist/maps.d.ts",
      "default": "./dist/maps.js"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "default": "./dist/stream.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/*.test.js\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3"
  }
}
